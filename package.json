{
  "name": "myday-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MyDay — Private, cross-device personal platform",
  "scripts": {
    "build": "pnpm -r --filter=!@myday/client run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev:api": "pnpm --filter @myday/api dev",
    "dev:client": "pnpm --filter @myday/client dev",
    "dev:web": "pnpm --filter @myday/client web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.20.0"
}
